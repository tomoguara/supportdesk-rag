@startuml
title SupportDesk RAG - Full System Architecture
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam backgroundColor white
skinparam shadowing true
skinparam defaultFontSize 13
skinparam arrowFontSize 12

actor "Incident Responder / User" as User

package "Offline Pipeline (Stages 1-3)" {
  rectangle "Ticket Source\n(JSON/CSV/DB)" as TicketSource
  rectangle "1. Ingest\n(clean, chunk, dedupe)" as Stage1
  rectangle "2. Embed\n(vector embeddings)" as Stage2
  rectangle "3. Vector Store\n(Qdrant DB)" as VectorStore
}

package "Online RAG (Stages 4-8)" {
  rectangle "4. Hybrid Retrieve\n(vector + BM25 + RRF)" as Stage4
  rectangle "5. Re-rank\n(cross-encoder)" as Stage5
  rectangle "6. Ground\n(assemble context)" as Stage6
  rectangle "7. Generate\n(LLM answer)" as Stage7
  rectangle "8. Guardrails\n(citation check, PII redact)" as Stage8
}

package "Observability & Evaluation" {
  rectangle "Metrics & Tracing" as Observability
  rectangle "Evaluation Framework" as Evaluation
}

' Offline Pipeline
TicketSource --> Stage1 : raw tickets
Stage1 --> Stage2 : text chunks
Stage2 --> VectorStore : vectors + metadata

' Online RAG Pipeline
User --> Stage4 : incident question
VectorStore --> Stage4 : top-k candidates
Stage4 --> Stage5 : candidates
Stage5 --> Stage6 : top-n grounded chunks
Stage6 --> Stage7 : grounded prompt
Stage7 --> Stage8 : answer + citations
Stage8 --> User : grounded answer with citations

' Observability
Stage7 --> Observability : latency, tokens, cost
Stage8 --> Observability : guard results
User --> Evaluation : golden answers
Evaluation --> Stage7 : metrics feedback

' Connections
Stage5 -up-> Stage8 : grounded context
Stage6 -up-> Stage8 : citations

legend right
  <b>Stages 1-3: Offline Pipeline</b><br/>
  Data ingestion, cleaning, chunking,<br/>
  embedding generation, and storage.<br/>
  <br/>
  <b>Stages 4-8: Online RAG</b><br/>
  Query processing, retrieval, re-ranking,<br/>
  context grounding, generation, and safety.<br/>
  <br/>
  <b>Guardrails (Stage 8)</b><br/>
  Citation verification, relevance checking,<br/>
  PII redaction, and refusal detection.
endlegend
@enduml
