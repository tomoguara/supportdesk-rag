# Model Selection Configuration
# Set USE_OLLAMA_MODELS to true to use local Ollama models (default: true)
# Set to false to use OpenAI cloud models
USE_OLLAMA_MODELS=true

# Ollama Configuration (used when USE_OLLAMA_MODELS=true)
# Base URL for Ollama's OpenAI-compatible API
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3

# OpenAI Configuration (used when USE_OLLAMA_MODELS=false)
OPENAI_API_KEY=your-openai-api-key-here
# Optional: Override OpenAI base URL (for Azure OpenAI, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: Override OpenAI models
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-3.5-turbo
